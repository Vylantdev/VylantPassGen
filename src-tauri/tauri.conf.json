{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VylantPassGen",
  "version": "1.0.0",
  "identifier": "dev.vylant.passgen",
  "build": {
    "frontendDist": "../dist/vylant-pass-gen/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VylantPassGen",
        "width": 560,
        "height": 660,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Vylantdev/VylantPassGen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENzg0M0I1N0I2QkE0QUUKUldTdXBHdDd0VU40aldzQlpEeGxQZ21KZjBaUE9HT3h0U1RYNWFaZjRpb1kyY2FRZ3J3SVVieEkK"
    }
  }
}
